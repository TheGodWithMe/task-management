<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Управление задачами проекта</title>
<link rel="stylesheet" href="/css/site.css" />
</head>
<body>
<header>
<a class="brand" href="/">Управление задачами</a>
@if(User.Identity?.IsAuthenticated == true)
{
<div class="account">
<span>@User.Identity.Name <small>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
</span>
<form method="post" action="/account/logout">@Html.AntiForgeryToken()<button class="quiet">Выйти</button>
</form>
</div>
}
</header>
<main>
@if(ViewData.Model is not WorkspaceModel { Details: not null } && TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
@if(ViewBag.Error is string loadError) { <div class="notice error" role="alert">@loadError</div> }
@if(ViewData.Model is not WorkspaceModel { Details: not null } && TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
@RenderBody()
</main>
</body>
</html>
